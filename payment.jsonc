{
  "name": "Payment",
  "type": "object",
  "properties": {
    "bill_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "method": {
      "type": "string",
      "enum": [
        "upi",
        "card",
        "net_banking",
        "auto"
      ],
      "default": "upi"
    },
    "transaction_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "pending",
        "failed"
      ],
      "default": "success"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "bill_id",
    "customer_id",
    "amount",
    "transaction_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
